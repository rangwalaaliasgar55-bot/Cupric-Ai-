{
  "name": "cupric-ai",
  "private": true,
  "version": "0.6.0",
  "description": "Cupric AI — desktop creator tool for short-form video: in-app Studio editor with liquid-glass effects, Gemini and free-model chat, Arena import, footage analysis, offline UI resource catalogs, and Electron packaging.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-packs.mjs && tsc --noEmit && node scripts/check-renderer.mjs && node scripts/check-encode-dims.mjs && node scripts/check-keyframe-edit.mjs && node scripts/check-agent-edits.mjs && node scripts/check-ai-connections.mjs && node scripts/check-updater.mjs && node scripts/check-resources.mjs && node scripts/check-template-fill.mjs && node scripts/check-automation-gate.mjs && node scripts/check-studio-surfaces.mjs && node scripts/check-voice.mjs && node scripts/check-scrub-perf.mjs && node scripts/check-progress-coverage.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "packs:build": "node scripts/build-packs.mjs",
    "check:renderer": "node scripts/check-renderer.mjs && node scripts/check-encode-dims.mjs",
    "check:encode-dims": "node scripts/check-encode-dims.mjs",
    "check:keyframes": "node scripts/check-keyframe-edit.mjs",
    "check:agent-edits": "node scripts/check-agent-edits.mjs",
    "check:ai": "node scripts/check-ai-connections.mjs",
    "check:updater": "node scripts/check-updater.mjs",
    "check:resources": "node scripts/check-resources.mjs",
    "check:template-fill": "node scripts/check-template-fill.mjs",
    "check:automation-gate": "node scripts/check-automation-gate.mjs",
    "check:studio-surfaces": "node scripts/check-studio-surfaces.mjs",
    "check:voice": "node scripts/check-voice.mjs",
    "check:perf": "node scripts/check-scrub-perf.mjs",
    "check:progress": "node scripts/check-progress-coverage.mjs",
    "stickers:build": "node scripts/build-stickers.mjs",
    "preview": "vite preview",
    "desktop": "concurrently -k -s first \"vite\" \"cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "dist:win": "npm run build && electron-builder --win",
    "resources:sync": "node scripts/sync-resources.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@google/generative-ai": "^0.24.1",
    "@remotion/player": "^4.0.529",
    "adm-zip": "^0.6.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.2",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.469.0",
    "motion": "^12.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.529",
    "simple-icons": "^16.32.0",
    "tailwind-merge": "^3.7.0",
    "twilio-video": "^2.36.0",
    "video.js": "^8.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "app.cupric-ai.studio",
    "productName": "Cupric AI",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "resources/**/*",
      "public/resources/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}-Portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "rangwalaaliasgar55-bot",
      "repo": "Cupric-Ai-"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ]
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  }
}
