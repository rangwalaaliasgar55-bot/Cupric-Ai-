{
 "name": "NewBrand production skills",
 "license": "MIT (NewBrand-authored guidance). Evidence links point to attributed Opus catalogue cases; cases are cited, not copied.",
 "skills": [
  {
   "id": "hook-construction",
   "name": "Hook construction",
   "when": "Every short-form video: the first 1–2 s decide retention.",
   "beats": [
    {
     "name": "Hook",
     "share": 0.12,
     "purpose": "State the payoff or tension in one legible line over the strongest visual"
    },
    {
     "name": "Body",
     "share": 0.73,
     "purpose": "Deliver the promise"
    },
    {
     "name": "Close",
     "share": 0.15,
     "purpose": "Resolve and CTA"
    }
   ],
   "shotSec": [
    0.8,
    2
   ],
   "transitions": [
    "cut",
    "push-up"
   ],
   "text": "One large line ≤ 7 words on frame 1, high contrast, inside safe area",
   "audio": "Hit or sound cue on the first cut; no fade-in from black",
   "requiredInputs": [
    "brief goal",
    "strongest visual"
   ],
   "avoid": [
    "Slow logo fades as the opener",
    "Claims you cannot verify"
   ],
   "matchTags": [
    "videoType:ad",
    "videoType:launch",
    "cat:brand-product"
   ],
   "energy": "high"
  },
  {
   "id": "product-demo-pacing",
