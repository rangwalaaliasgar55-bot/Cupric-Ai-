     "purpose": "What the user gets — only real, demonstrated outcomes"
    },
    {
     "name": "CTA",
     "share": 0.15,
     "purpose": "Where to get it"
    }
   ],
   "shotSec": [
    1.5,
    3
   ],
   "transitions": [
    "cut",
    "zoom",
    "glass-wipe"
   ],
   "text": "Feature captions ≤ 5 words, lower third",
   "audio": "Music bed; duck under any voiceover",
   "requiredInputs": [
    "product footage or screenshots",
    "feature list"
   ],
   "avoid": [
    "Invented metrics or reviews"
   ],
   "matchTags": [
    "videoType:product-demo",
    "cat:brand-product"
   ],
   "energy": "medium"
  },
